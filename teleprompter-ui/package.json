{
  "name": "teleprompt",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dist": "tsc -b && vite build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.teleprompt.app",
    "productName": "Teleprompt",
    "directories": {
      "output": "dist-bin"
    },
    "win": {
      "target": ["portable"]
    },
    "extraResources": [
      "prisma/**/*",
      "node_modules/@prisma/engines/**/*",
      "node_modules/.prisma/client/**/*"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^1.48.0",
    "prisma": "^5.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.1.0"
  }
}
