<Window x:Class="Teleprompter.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Teleprompter.Wpf"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="600" Width="1000"
        Background="#1E1E1E" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#252526" Padding="10">
            <StackPanel>
                <TextBlock Text="Teleprompter" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="#007ACC"/>
                <TextBox x:Name="SearchBox" Padding="5" Margin="0,0,0,10" Background="#333333" Foreground="White" BorderThickness="0" Text="Pesquisar..." />
                
                <TreeView Background="Transparent" Foreground="White" BorderThickness="0">
                    <TreeViewItem Header="Minhas Músicas" IsExpanded="True">
                        <!-- Itens virão do ViewModel depois -->
                    </TreeViewItem>
                    <TreeViewItem Header="Repertórios" />
                </TreeView>
            </StackPanel>
        </Border>

        <!-- Divisor -->
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="#3E3E42" />

        <!-- Main Area (Leitura/Edição) -->
        <Grid Grid.Column="2" Background="#1E1E1E">
            <TextBlock Text="Nenhuma música selecionada" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888" FontSize="16" />
        </Grid>
    </Grid>
</Window>
