<Window x:Class="Teleprompter.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="700" Width="1100"
        Background="#1E1E1E" Foreground="White">
    
    <Grid Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#252526" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Cabeçalho -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Teleprompter" FontSize="20" FontWeight="Bold" Foreground="#007ACC" VerticalAlignment="Center"/>
                </Grid>

                <!-- Search Bar + Botão Plus -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0" Margin="0,0,5,0">
                        <TextBox x:Name="SearchBox" Padding="5" Background="#333333" Foreground="White" BorderThickness="0" TextChanged="SearchBox_TextChanged" />
                        <TextBlock IsHitTestVisible="False" Text="Pesquisar..." Foreground="#888888" Margin="7,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    
                    <Button Grid.Column="1" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Background="#007ACC" Foreground="White" BorderThickness="0" Width="30" Cursor="Hand" ToolTip="Importar/Criar Música"/>
                </Grid>
                
                <!-- Hierarchical TreeView with Context Menus -->
                <TreeView Grid.Row="2" Background="Transparent" BorderThickness="0" 
                          ItemsSource="{Binding TreeNodes}" SelectedItemChanged="TreeView_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="White"/>
                            <!-- Context Menu para cada Nó -->
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu Background="#252526" Foreground="White">
                                        <MenuItem Header="Abrir no Palco" Click="ContextMenu_Stage_Click" />
                                        <MenuItem Header="Favoritar/Desfavoritar" Click="ContextMenu_Favorite_Click" />
                                        <Separator Background="#3E3E42" />
                                        <MenuItem Header="Editar Nome" />
                                        <MenuItem Header="Excluir" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Header}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                
                <!-- Rodapé (Gear + Configurações) -->
                <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                    <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="18" Padding="5" Cursor="Hand" ToolTip="Configurações"/>
                    <TextBlock Text="Configurações" Foreground="#888888" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Divisor -->
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="#3E3E42" />

        <!-- Main Area (Leitura/Edição) -->
        <Grid Grid.Column="2" Background="#1E1E1E">
            
            <TextBlock Text="Selecione uma música..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888" FontSize="16" >
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Hidden"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSong}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
            <!-- Contexto da Música -->
            <Grid DataContext="{Binding}" Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSong}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Top Header: Título à esquerda, Ações à direita -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SelectedSong.Title}" FontSize="28" FontWeight="Bold" Foreground="#007ACC" />
                        <TextBlock Text="{Binding SelectedSong.Artist}" FontSize="16" Foreground="#CCCCCC" />
                    </StackPanel>
                    
                    <!-- Barra de Ações (Leitura) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <!-- Abrir Palco -->
                        <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets" ToolTip="Abrir no Palco" Background="Transparent" Foreground="#28A745" BorderThickness="0" FontSize="20" Padding="10" Cursor="Hand" Click="OpenStage_Click"/>
                        
                        <!-- Editar -->
                        <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" ToolTip="Editar" Command="{Binding EnterEditModeCommand}" Background="Transparent" Foreground="#007ACC" BorderThickness="0" FontSize="20" Padding="10" Cursor="Hand" />
                        
                        <!-- Favoritar -->
                        <Button Content="&#xE734;" FontFamily="Segoe MDL2 Assets" ToolTip="Favoritar/Desfavoritar" Command="{Binding ToggleFavoriteCommand}" Background="Transparent" Foreground="#FFD700" BorderThickness="0" FontSize="20" Padding="10" Cursor="Hand" />
                        
                        <!-- Excluir -->
                        <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Excluir" Background="Transparent" Foreground="#DC3545" BorderThickness="0" FontSize="20" Padding="10" Cursor="Hand" />
                    </StackPanel>
                    
                    <!-- Barra de Ações (Edição) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <!-- Cancelar -->
                        <Button Content="&#xE711; Cancelar" FontFamily="Segoe MDL2 Assets" Command="{Binding CancelEditCommand}" Background="#DC3545" Foreground="White" BorderThickness="0" FontSize="14" Padding="10,5" Margin="0,0,10,0" Cursor="Hand" />
                        
                        <!-- Salvar -->
                        <Button Content="&#xE73E; Salvar" FontFamily="Segoe MDL2 Assets" Command="{Binding SaveSongCommand}" Background="#28A745" Foreground="White" BorderThickness="0" FontSize="14" Padding="10,5" Cursor="Hand" />
                    </StackPanel>
                </Grid>
                
                <!-- Editor / Reader Body -->
                <TextBox Grid.Row="1" Text="{Binding SelectedSong.RawContent, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True" 
                         Background="#1E1E1E" Foreground="#E0E0E0" 
                         FontFamily="Consolas" FontSize="16" 
                         BorderThickness="0" Padding="0,10,0,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="IsReadOnly" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="IsReadOnly" Value="False"/>
                                    <Setter Property="Background" Value="#252526"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                         <!-- The Converter is hypothetical, we'll implement it or use triggers -->
                         
            </Grid>
        </Grid>
    </Grid>
</Window>
